{
  "workflow-monitor-session": {
    "SessionStart": [
      {
        "type": "command",
        "command": "if exist ..\\..\\..\\workflow-monitor.exe (..\\..\\..\\workflow-monitor.exe agent-hook) else if exist ..\\..\\..\\..\\..\\workflow-monitor.exe (..\\..\\..\\..\\..\\workflow-monitor.exe agent-hook) else (echo {})",
        "timeout": 30
      }
    ]
  },
  "workflow-monitor-guard": {
    "PreToolUse": [
      {
        "matcher": "write_file|edit_file",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File hooks\\pre-tool-guard.ps1",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File hooks\\pre-tool-guard.ps1",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
